static func get_skin(id: String) -> Dictionary:
	for s in LIST:
		if s["id"] == id:
			return s
	return LIST[0]


static func get_piece_modulate(skin_id: String, is_black: bool) -> Color:
	var skin := get_skin(skin_id)
	return skin.get("black_col" if is_black else "white_col", Color.WHITE)


static func get_army_palette(skin_id: String, army_id: int) -> Dictionary:
	var skin := get_skin(skin_id)
	var w_pal: Dictionary = skin.get("white_palette", LIST[0]["white_palette"])
	var b_pal: Dictionary = skin.get("black_palette", LIST[0]["black_palette"])
	match army_id:
		0: # Белые
			return w_pal
		2: # Чёрные
			return b_pal
		1: # Красные (Мульти-шахматы) — рубиново-алая броня с отделкой активного скина
			return {
				"aura": "#f43f5e",
				"body_top": "#ffe4e6",
				"body_mid": "#fb7185",
				"body_bot": "#be123c",
				"facet_light": "#fff1f2",
				"facet_dark": "#881337",
				"trim_top": w_pal.get("trim_top", "#fef08a"),
				"trim_bot": w_pal.get("trim_bot", "#d97706"),
				"pedestal_top": "#fda4af",
				"pedestal_bot": "#881337",
				"stroke": "#3b0414",
				"rim": "#fecdd3",
				"core_bright": b_pal.get("core_bright", "#fef08a"),
				"core_outer": b_pal.get("core_outer", "#f97316"),
			}
		3: # Синие (Мульти-шахматы) — кобальтово-сапфировая броня с отделкой активного скина
			return {
				"aura": "#3b82f6",
				"body_top": "#dbeafe",
				"body_mid": "#60a5fa",
				"body_bot": "#1d4ed8",
				"facet_light": "#eff6ff",
				"facet_dark": "#1e3a8a",
				"trim_top": w_pal.get("trim_top", "#fef08a"),
				"trim_bot": w_pal.get("trim_bot", "#d97706"),
				"pedestal_top": "#93c5fd",
				"pedestal_bot": "#1e3a8a",
				"stroke": "#091945",
				"rim": "#bfdbfe",
				"core_bright": w_pal.get("core_bright", "#e0f2fe"),
				"core_outer": w_pal.get("core_outer", "#06b6d4"),
			}
	return w_pal
